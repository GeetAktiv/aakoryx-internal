        <!-- A. V. Lauttamus Communications, Inc. - 2 Way Radio -->
        <record id="helpdesk.helpdesk_team1" model="helpdesk.team">
            <field name="name">2 Way Radio - Support</field>
            <field name="alias_name"></field>
            <field name="member_ids" eval="[(Command.UNLINK, ref('base.user_admin'))]"/>
            <field name="use_fsm">True</field>
            <field name="fsm_project_id" ref="aak_sales_data.fsm_project_2way_radio_service"/>
            <field name="use_product_repairs">True</field>
        </record>

