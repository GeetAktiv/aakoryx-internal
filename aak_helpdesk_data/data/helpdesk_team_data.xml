            <field name="alias_name"></field>
            <field name="stage_ids" eval="[
                (Command.LINK, ref('helpdesk.stage_new')),
                (Command.LINK, ref('helpdesk.stage_in_progress')),
                (Command.LINK, ref('helpdesk.stage_on_hold')),
                (Command.LINK, ref('helpdesk.stage_solved')),
                (Command.LINK, ref('helpdesk.stage_cancelled')),
            ]"/>
            <field name="use_sla" eval="True"/>
            <field name="member_ids" eval="[]"/>
            <field name="company_id" ref="base.main_company"/>
