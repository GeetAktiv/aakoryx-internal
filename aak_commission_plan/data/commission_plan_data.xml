<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="plan_sales_manager" model="sale.commission.plan">
            <field name="name">Sales Manager Achievement</field>
            <field name="date_from" eval="DateTime.today() - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today() + relativedelta(day=31, month=12)"/>
            <field name="type">achieve</field>
            <field name="user_type">team</field>
            <field name="team_id" ref="sales_team.team_sales_department"/>
            <field name="state">approved</field>
            <field name="user_ids" eval="[
                (0, 0, {'user_id': ref('aak_base_data.res_users_bill_gras')}),
                (0, 0, {'user_id': ref('aak_base_data.res_users_bob_mead')}),
                (0, 0, {'user_id': ref('aak_base_data.res_users_connor_mogan')})
            ]"/>
        </record>
        <record id="plan_sales_representative" model="sale.commission.plan">
            <field name="name">Sales Representative Targets</field>
            <field name="date_from" eval="DateTime.today() - relativedelta(years=1, day=1, month=1)"/>
            <field name="date_to" eval="DateTime.today() + relativedelta(day=31, month=12)"/>
            <field name="commission_amount">1500</field>
            <field name="type">target</field>
            <field name="state">approved</field>
            <field name="achievement_ids" eval="False"/>
            <field name="user_ids" eval="[
                (0, 0, {'user_id': ref('aak_base_data.res_users_jim_kaczynski')}),
                (0, 0, {'user_id': ref('aak_base_data.res_users_john_gross')}),
                (0, 0, {'user_id': ref('aak_base_data.res_users_tim_smith')}),
                (0, 0, {'user_id': ref('aak_base_data.res_users_wayne_wells')})
            ]"/>
        </record>
    </data>
</odoo>
