<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle ID auto-numbering sequence -->
    <record id="seq_fleet_vehicle_custom" model="ir.sequence">
        <field name="name">Vehicle ID Sequence</field>
        <field name="code">fleet.vehicle.custom</field>
        <field name="prefix">VEH-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
