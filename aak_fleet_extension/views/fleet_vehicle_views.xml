<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_vehicle_id" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.vehicle.id</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='next_assignation_date']" position="after">
                <field name="vehicle_id_custom"/>
                <field name="customer_id"/>
                <field name="make_id"/>
                <field name="model_id" string="Model"/>
                <field name="previous_installations"/>
                <field name="radio_model"/>
                <field name="installation_location"/>
                <field name="antenna_type"/>
                <field name="photo_ids" widget="many2many_binary"/>
            </xpath>

            <xpath expr="//field[@name='model_year']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='vin_sn']" position="attributes">
                <attribute name="string">VIN</attribute>
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="string">Vehicle Type</attribute>
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="string">Installation Notes</attribute>
            </xpath>
        </field>
    </record>
</odoo>
