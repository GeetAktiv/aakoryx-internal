<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Create a new survey -->
    <record id="customer_satisfaction_survey" model="survey.survey">
        <field name="title">Customer Satisfaction Survey</field>
        <field name="description">
            We value your feedback! Please answer these questions to help us improve our security products and services.
        </field>
        <field name="active">True</field>
        <field name="survey_type">survey</field>
        <field name="questions_layout">one_page</field>
    </record>

    <!-- Question 1: Satisfaction with service -->
    <record id="survey_question_satisfaction" model="survey.question">
        <field name="survey_id" ref="customer_satisfaction_survey"/>
        <field name="title">How satisfied are you with the security products and installation services you received from
            Lauttamus Security?
        </field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory">True</field>
        <field name="sequence">1</field>
    </record>

    <!-- Choices for Question 1 -->
    <record id="survey_question_satisfaction_opt1" model="survey.question.answer">
        <field name="question_id" ref="survey_question_satisfaction"/>
        <field name="value">Very Satisfied</field>
    </record>
    <record id="survey_question_satisfaction_opt2" model="survey.question.answer">
        <field name="question_id" ref="survey_question_satisfaction"/>
        <field name="value">Satisfied</field>
    </record>
    <record id="survey_question_satisfaction_opt3" model="survey.question.answer">
        <field name="question_id" ref="survey_question_satisfaction"/>
        <field name="value">Neutral</field>
    </record>
    <record id="survey_question_satisfaction_opt4" model="survey.question.answer">
        <field name="question_id" ref="survey_question_satisfaction"/>
        <field name="value">Dissatisfied</field>
    </record>
    <record id="survey_question_satisfaction_opt5" model="survey.question.answer">
        <field name="question_id" ref="survey_question_satisfaction"/>
        <field name="value">Very Dissatisfied</field>
    </record>

    <!-- Question 2: Performance and reliability -->
    <record id="survey_question_performance_reliability" model="survey.question">
        <field name="survey_id" ref="customer_satisfaction_survey"/>
        <field name="title">How would you rate the performance and reliability of your security system (alarm, cameras,
            or access control)?
        </field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory">True</field>
        <field name="sequence">2</field>
    </record>

    <!-- Choices for Question 2 -->
    <record id="survey_question_performance_reliability_opt1" model="survey.question.answer">
        <field name="question_id" ref="survey_question_performance_reliability"/>
        <field name="value">Excellent</field>
    </record>
    <record id="survey_question_performance_reliability_opt2" model="survey.question.answer">
        <field name="question_id" ref="survey_question_performance_reliability"/>
        <field name="value">Good</field>
    </record>
    <record id="survey_question_performance_reliability_opt3" model="survey.question.answer">
        <field name="question_id" ref="survey_question_performance_reliability"/>
        <field name="value">Fair</field>
    </record>
    <record id="survey_question_performance_reliability_opt4" model="survey.question.answer">
        <field name="question_id" ref="survey_question_performance_reliability"/>
        <field name="value">Poor</field>
    </record>

    <!-- Question 3: Satisfaction with technicians -->
    <record id="survey_question_technician_satisfaction" model="survey.question">
        <field name="survey_id" ref="customer_satisfaction_survey"/>
        <field name="title">How satisfied are you with the professionalism and knowledge of our technicians and
            installers?
        </field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory">True</field>
        <field name="sequence">3</field>
    </record>

    <!-- Choices for Question 3 -->
    <record id="survey_question_technician_satisfaction_opt1" model="survey.question.answer">
        <field name="question_id" ref="survey_question_technician_satisfaction"/>
        <field name="value">Very Satisfied</field>
    </record>
    <record id="survey_question_technician_satisfaction_opt2" model="survey.question.answer">
        <field name="question_id" ref="survey_question_technician_satisfaction"/>
        <field name="value">Satisfied</field>
    </record>
    <record id="survey_question_technician_satisfaction_opt3" model="survey.question.answer">
        <field name="question_id" ref="survey_question_technician_satisfaction"/>
        <field name="value">Neutral</field>
    </record>
    <record id="survey_question_technician_satisfaction_opt4" model="survey.question.answer">
        <field name="question_id" ref="survey_question_technician_satisfaction"/>
        <field name="value">Dissatisfied</field>
    </record>
    <record id="survey_question_technician_satisfaction_opt5" model="survey.question.answer">
        <field name="question_id" ref="survey_question_technician_satisfaction"/>
        <field name="value">Very Dissatisfied</field>
    </record>

    <!-- Question 4: Response to service requests -->
    <record id="survey_question_service_response" model="survey.question">
        <field name="survey_id" ref="customer_satisfaction_survey"/>
        <field name="title">Did our team respond promptly to your service or support requests?</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory">True</field>
        <field name="sequence">4</field>
    </record>

    <!-- Choices for Question 4 -->
