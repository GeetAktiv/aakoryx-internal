    <record id="survey_question_service_response_opt2" model="survey.question.answer">
        <field name="question_id" ref="survey_question_service_response"/>
        <field name="value">Usually</field>
    </record>
    <record id="survey_question_service_response_opt3" model="survey.question.answer">
        <field name="question_id" ref="survey_question_service_response"/>
        <field name="value">Sometimes</field>
    </record>
    <record id="survey_question_service_response_opt4" model="survey.question.answer">
        <field name="question_id" ref="survey_question_service_response"/>
        <field name="value">Rarely</field>
    </record>
    <record id="survey_question_service_response_opt5" model="survey.question.answer">
        <field name="question_id" ref="survey_question_service_response"/>
        <field name="value">Never</field>
    </record>

    <!-- Question 5: Likelihood of recommendation -->
    <record id="survey_question_recommendation" model="survey.question">
        <field name="survey_id" ref="customer_satisfaction_survey"/>
        <field name="title">How likely are you to recommend Lauttamus Security to others?</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory">True</field>
        <field name="sequence">5</field>
    </record>

    <!-- Choices for Question 5 -->
    <record id="survey_question_recommendation_opt1" model="survey.question.answer">
        <field name="question_id" ref="survey_question_recommendation"/>
        <field name="value">Very Likely</field>
    </record>
    <record id="survey_question_recommendation_opt2" model="survey.question.answer">
        <field name="question_id" ref="survey_question_recommendation"/>
        <field name="value">Likely</field>
    </record>
    <record id="survey_question_recommendation_opt3" model="survey.question.answer">
        <field name="question_id" ref="survey_question_recommendation"/>
        <field name="value">Neutral</field>
