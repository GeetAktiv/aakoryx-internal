    <record id="survey_question_additional_solutions_opt3" model="survey.question.answer">
        <field name="question_id" ref="survey_question_additional_solutions"/>
        <field name="value">Access Control</field>
    </record>
    <record id="survey_question_additional_solutions_opt4" model="survey.question.answer">
