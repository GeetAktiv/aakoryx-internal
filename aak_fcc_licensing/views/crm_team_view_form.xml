<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_team_form_inherit_fcc" model="ir.ui.view">
        <field name="name">crm.team.form.inherit.fcc</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="crm.sales_team_form_view_in_crm"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='leads']" position="after">
                <span name="fcc_licence">
                    <field name="fcc_licence_required"/>
                    <label for="fcc_licence_required" string="FCC Licence Required?"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>