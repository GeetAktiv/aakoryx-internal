<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company-agnostic sequence (set company_id if you want per-company numbering) -->
    <record id="seq_crm_lead_uid" model="ir.sequence">
        <field name="name">CRM Lead ID</field>
        <field name="code">crm.lead.lead_uid</field>
        <field name="prefix">LEAD-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
