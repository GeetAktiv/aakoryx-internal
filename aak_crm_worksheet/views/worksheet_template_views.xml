<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_stage_worksheet_template_action_settings" model="ir.actions.act_window" >
        <field name="name">CRM Stage Worksheet Templates</field>
        <field name="res_model">worksheet.template</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="domain">[('res_model', '=', 'crm.lead')]</field>
        <field name="context">
            {
                'default_res_model': 'crm.lead',
            }
        </field>
    </record>

    <!-- settings menu -->
    <menuitem id="settings_crm_stage_worksheet_template"
        name="Stages Worksheet Templates"
        sequence="20"
        action="crm_stage_worksheet_template_action_settings"
        parent="crm.menu_crm_config_lead"
        groups="sales_team.group_sale_manager"/>

</odoo>
