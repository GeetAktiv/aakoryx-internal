<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="template_fsm_response_thankyou" name="FSM Response Thank You Page">
        <div style="max-width:820px;margin:24px auto;padding:32px;font-family:Arial,Helvetica,sans-serif;">
            <div style="border:1px solid #eee;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.06);padding:28px;text-align:center;">
                <h2 style="color:#198754;margin:0 0 12px;">Thank You!</h2>
                <p style="font-size:16px;margin:0;">
                    Your response (
                    <strong>
                        <t t-esc="answer"/>
                    </strong>
                    ) has been recorded successfully.
                </p>
            </div>
        </div>
    </template>
</odoo>
