<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="wan_tower_product_main" model="product.product">
            <field name="name">WAN Tower</field>
            <field name="service_tracking">task_global_project</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="service_policy">delivered_timesheet</field>
            <field name="rent_ok" eval="True"/>
        </record>
        <record id="2way_radio_product_main" model="product.product">
            <field name="name">2Way Radio</field>
            <field name="service_tracking">task_global_project</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="service_policy">delivered_timesheet</field>
            <field name="rent_ok" eval="True"/>
        </record>
        <record id="security_installation_product_main" model="product.product">
            <field name="name">Security Installation</field>
            <field name="service_tracking">task_global_project</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="service_policy">delivered_timesheet</field>
            <field name="rent_ok" eval="True"/>
        </record>
        <record id="fcc_charges" model="product.product">
            <field name="name">FCC charges</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="service_policy">delivered_timesheet</field>
        </record>

        <!-- Subscription Product -->
        <record id="product_template_maintenance" model="product.template">
            <field name="name">Maintenance</field>
            <field name="list_price">1.00</field>
            <field name="standard_price">1.00</field>
            <field name="type">service</field>
            <field name="recurring_invoice">True</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="service_tracking">task_global_project</field>
        </record>
    </data>
</odoo>
