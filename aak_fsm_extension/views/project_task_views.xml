<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherit_field_service" model="ir.ui.view">
        <field name="name">project.task.form.field.service.extension</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="work_ticket_id" readonly="1"/>
                <field name="service_type"/>
                <field name="bom_id"/>
                <field name="technical_requirements"/>
                <field name="fcc_license"/>
                <field name="scheduled_datetime"/>
                <field name="vehicle_assignment_id"/>
                <field name="vehicle_information"/>
                <field name="special_instructions"/>
                <field name="reference_documents" widget="many2many_binary"/>
            </xpath>

            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="string">Assigned Technician(s)</attribute>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                        name="action_open_related_vehicle"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-car"
                        string="Vehicle"
                >
                </button>
            </xpath>

        </field>
    </record>

    <record id="view_task_form2_inherit_hide_material_button" model="ir.ui.view">
        <field name="name">view.task.form2.inherit.hide.material.button</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm_stock.view_task_form2_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_fsm_view_material']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_fsm_view_material']" position="after">
                <button class="oe_stat_button" name="action_fsm_view_sol_products"
                        groups="sales_team.group_sale_salesman,industry_fsm.group_fsm_quotation_from_task"
                        type="object" icon="fa-cart-plus"
                        invisible="not partner_id and not is_fsm or not allow_material">
                    <div class="o_stat_info">
                        <span class="o_stat_text d-flex align-items-baseline gap-1">
                            <field name="sol_products_count" widget="statinfo" string="Products" nolabel="1"
                                   class="oe_inline"/>
                            <span>Products</span>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
