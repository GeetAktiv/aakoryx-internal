<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="component_list_view_list" model="ir.ui.view">
        <field name="name">component.list.view.list</field>
        <field name="model">component.list</field>
        <field name="arch" type="xml">
            <list string="BOM Inventory">
                <field name="name"/>
                <field name="product_id" domain="[('type', '=', 'service')]" required="1"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="component_list_view_form" model="ir.ui.view">
        <field name="name">component.list.form</field>
        <field name="model">component.list</field>
        <field name="arch" type="xml">
            <form string="BOM Inventory">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" domain="[('type', '=', 'service')]" required="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="version"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Components" name="product_components">
                            <field
                            name="product_components_ids"
                            mode="list">
                                <list
                                string="Product Components"
                                editable="bottom"
                                limit="200"
                                >
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                    </control>
                                    <field name="product_id" domain="[('type', '!=', 'service')]"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS (WINDOW) -->

    <record id="action_component_list" model="ir.actions.act_window">
        <field name="name">BOM Inventory</field>
        <field name="res_model">component.list</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new component list, the first step of a new component list!
            </p>
        </field>
    </record>
</odoo>
