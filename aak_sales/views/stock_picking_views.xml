<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherited_aak_sales" model="ir.ui.view">
            <field name="name">stock.picking.form.inherited.aak.sales</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='operations']/field[@name='move_ids_without_package']/list/field[@name='product_id']" position="attributes">
                    <attribute name="domain">[('is_equipment', '=', False)]</attribute>
                </xpath>
            </field>
    </record>
</odoo>
