<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherited_aak_sales" model="ir.ui.view">
        <field name="name">sale.order.form.inherited.aak.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,sent,reviewed,sale"/>
            </xpath>
            <xpath expr="//button[@name='action_confirm' and @id='action_confirm']" position="attributes">
                <attribute name="invisible">not (state in ['sent', 'reviewed'])</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="before">
                <button name="%(aak_sales.action_sale_component)d" type="action" string="BOM Inventory" class="btn-primary"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('sale_ok', '=', True),('is_equipment', '=', False)]</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][last()]" position="after">
                <button name="action_check_availability" string="Review Order" type="object" class="btn btn-secondary" invisible="state in 'reviewed'"/>
            </xpath>
        </field>
    </record>
</odoo>
