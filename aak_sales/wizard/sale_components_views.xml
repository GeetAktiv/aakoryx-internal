<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_component_view_form" model="ir.ui.view">
        <field name="name">sale.component.view.form</field>
        <field name="model">sale.component</field>
        <field name="arch" type="xml">
            <form string="BOM Inventory">
                <sheet>
                    <group>
                        <field name="product_id" domain="[('type', '=', 'service')]"/>
                        <field name="component_id" domain="[('product_id', '=', product_id)]" options="{'no_create': True}"/>
                        <field name="quantity"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
                <footer>
                    <!-- Save Button -->
                    <button string="Save"
                            type="object"
                            name="action_add_component"
                            class="btn-primary"/>

                    <!-- Cancel Button -->
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sale_component" model="ir.actions.act_window">
        <field name="name">BOM Inventory</field>
        <field name="res_model">sale.component</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Adds BOM Inventory to Sale Order Line.
            </p>
        </field>
    </record>
</odoo>
