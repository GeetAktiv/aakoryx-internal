<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- A. V. Lauttamus Communications, Inc. - 2 Way Radio, Timesheet Billable Service Product-->
        <record id="industry_fsm_sale.field_service_product" model="product.product">
            <field name="name">Field Service - 2 Way Radio</field>
            <field name="project_id" search="[('id', '=?', ref('aak_sales_data.fsm_project_2way_radio_service', raise_if_not_found=False)), ('is_fsm', '=', True)]"/>
        </record>

        <!-- A. V. Lauttamus Communications, Inc. - Answering Service, Timesheet Billable Service Product-->
        <record id="field_service_product_answering_service" model="product.product">
